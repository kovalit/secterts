# Copy to deploy/backend.env and fill in real values.
APP_ENV=dev
APP_PORT=8080

# Inside docker-compose the host is "postgres"; for local `make backend` use localhost.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/secrets_center?sslmode=disable

# 32-byte key, base64 encoded. Generate with: ./scripts/generate-master-key.sh
APP_MASTER_KEY_V1_BASE64=

# Long random string used to sign nothing sensitive yet; reserved for future JWT use.
JWT_ACCESS_SECRET=change-me

COOKIE_DOMAIN=localhost
# Set to true only behind HTTPS (production).
COOKIE_SECURE=false

# SMTP is optional in dev: if SMTP_HOST is empty the 2FA code is logged to stdout.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

CORS_ORIGINS=http://localhost:5173
